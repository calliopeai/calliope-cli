{
  "name": "@calliopelabs/cli",
  "version": "2.5.0",
  "description": "Calliope - Multi-model AI agent CLI with autonomous loops, project memory, and advanced tooling",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "anthropic",
    "claude",
    "gemini",
    "openai",
    "terminal",
    "calliope",
    "agentic"
  ],
  "author": "Calliope Labs Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/calliopeai/calliope-cli.git"
  },
  "homepage": "https://github.com/calliopeai/calliope-cli#readme",
  "bugs": {
    "url": "https://github.com/calliopeai/calliope-cli/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "calliope": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js",
    "dev": "tsc --watch",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/generative-ai": "^0.24.1",
    "@inquirer/prompts": "^7.2.0",
    "conf": "^13.0.1",
    "ink": "^6.6.0",
    "openai": "^4.77.0",
    "react": "^19.2.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.7",
    "@vitest/coverage-v8": "^4.0.16",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  },
  "optionalDependencies": {
    "@calliopelabs/cli-themes": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
