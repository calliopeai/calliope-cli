{
  "name": "@calliopelabs/cli",
  "version": "3.2.1",
  "description": "The private-AI agent CLI - one terminal agent for any model backend, including the ones you run yourself",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "anthropic",
    "claude",
    "gemini",
    "openai",
    "terminal",
    "calliope",
    "agentic"
  ],
  "author": "Calliope Labs Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/calliopeai/calliope-cli.git"
  },
  "homepage": "https://github.com/calliopeai/calliope-cli#readme",
  "bugs": {
    "url": "https://github.com/calliopeai/calliope-cli/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "calliope": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "scripts/verify-runlog.mjs"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js",
    "dev": "tsc --watch",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/run.mjs",
    "bench:cold": "npm run build && node bench/cold-start.mjs",
    "bench:binary": "npm run build && bun packaging/build-binary.mjs --native && CALLIOPE_BENCH_BINARY=packaging/dist/calliope-native node bench/cold-start.mjs",
    "bench:ui": "vitest run -c bench/vitest.bench.config.ts bench/keystroke.bench.test.ts",
    "bench:mem": "NODE_OPTIONS=--expose-gc vitest run -c bench/vitest.bench.config.ts bench/memory.bench.test.ts",
    "prepublishOnly": "npm run build && npm test && npm run test:conformance:release",
    "test:conformance": "vitest run tests/provider-conformance.test.ts tests/provider-captures.test.ts tests/provider-readiness.test.ts tests/provider-probe-budget.test.ts tests/provider-semantic.test.ts tests/provider-semantic-recorder.test.ts tests/provider-semantic-captures.test.ts tests/provider-semantic-cli.test.ts",
    "test:conformance:release": "CALLIOPE_REQUIRE_WIRE_CAPTURES=1 CALLIOPE_RELEASE_DEFERRED_PROVIDERS=xai npm run test:conformance",
    "capture:provider": "npm run build && node scripts/conformance/capture.mjs",
    "providers:readiness": "npm run build && node scripts/conformance/report.mjs",
    "capture:semantics": "npm run build && node scripts/conformance/capture-semantic.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@google/genai": "^2.22.0",
    "@inquirer/prompts": "^8.5.2",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "conf": "^15.1.0",
    "ink": "^7.1.0",
    "openai": "^6.46.0",
    "react": "^19.2.3",
    "sql.js": "1.14.2",
    "string-width": "8.2.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/sql.js": "1.4.11",
    "@vitest/coverage-v8": "^4.0.16",
    "ink-testing-library": "^4.0.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
